<div class="nav-menu @(IsCollapsed ? "nav-menu-collapsed" : "")">
    <div class="nav-header">
        <div class="nav-header-content">
            <a class="navbar-brand" href="/">TOTEM Sales</a>
            <button type="button"
                    class="nav-collapse-toggle"
                    title="@(IsCollapsed ? "Разшири менюто" : "Свий менюто")"
                    aria-label="@(IsCollapsed ? "Разшири менюто" : "Свий менюто")"
                    @onclick="OnToggleCollapsed">
                <span class="bi @(IsCollapsed ? "bi-chevron-right" : "bi-chevron-left")" aria-hidden="true"></span>
            </button>
        </div>
    </div>

    <input type="checkbox" title="Navigation menu" class="navbar-toggler" />

    <div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
        <nav class="nav flex-column">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All" title="Home">
                    <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span>
                    <span class="nav-link-text">Home</span>
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="events" title="Събития">
                    <span class="bi bi-calendar-heart" aria-hidden="true"></span>
                    <span class="nav-link-text">Събития</span>
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="statistics/compare-days" title="Стат. по дни">
                    <span class="bi bi-graph-up" aria-hidden="true"></span>
                    <span class="nav-link-text">Стат. по дни</span>
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="statistics/compare-events" title="Стат. по събития">
                    <span class="bi bi-graph-up-arrow" aria-hidden="true"></span>
                    <span class="nav-link-text">Стат. по събития</span>
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin/prices" title="Цени">
                    <span class="bi bi-tags" aria-hidden="true"></span>
                    <span class="nav-link-text">Цени</span>
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="weather" title="Дали вали">
                    <span class="bi bi-cloud-rain" aria-hidden="true"></span>
                    <span class="nav-link-text">Дали вали 👀</span>
                </NavLink>
            </div>

            <AuthorizeView>
                <Authorized>
                    <div class="nav-item px-3 mt-auto">
                        <a class="nav-link" href="/logout" title="Logout">
                            <span class="bi bi-box-arrow-right" aria-hidden="true"></span>
                            <span class="nav-link-text">Logout</span>
                        </a>
                    </div>
                </Authorized>
            </AuthorizeView>
        </nav>
    </div>
</div>

@code {
    [Parameter]
    public bool IsCollapsed { get; set; }

    [Parameter]
    public EventCallback OnToggleCollapsed { get; set; }
}
