@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar @(isNavCollapsed ? "sidebar-collapsed" : "")">
        <NavMenu IsCollapsed="isNavCollapsed" OnToggleCollapsed="ToggleNavCollapsed" />
    </div>

    <main>
        @* <div class="top-row px-4">
            <p class="mb-1">Beta version - New features coming soon!</p>
        </div> *@
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private bool isNavCollapsed;

    private void ToggleNavCollapsed()
    {
        isNavCollapsed = !isNavCollapsed;
    }
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
