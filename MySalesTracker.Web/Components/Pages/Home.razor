@page "/"
@page "/home"
@attribute [Authorize]

<PageTitle>Home</PageTitle>

<div class="home-page text-center">
    <img class="home-logo" src="images/logo01_retina.png" alt="Home image" />
    <div class="home-actions">
        <div class="home-button-container">
            <NavLink class="home-nav-button" href="weather">
                <h3>Дали Вали?<br /> ⛈️ ⛵ 💼 💦 👀</h3>
            </NavLink>
        </div>
        <div class="home-button-container">
            <NavLink class="home-nav-button" href="events">
                <h3>Ще се работи!<br /> 🤞 🏄‍♀️ 📋</h3>
            </NavLink>
        </div>
    </div>
    <div class="home-image-container">
        <img class="home-image" src="images/kuker1000.png" alt="Home image" />
    </div>
</div>

@*Inline styles in component files should be moved to a separate CSS file or CSS
isolation file (Home.razor.css)to follow Blazor best practices and improve maintainability.
For some reason if we did this, it breaks the style!*@
<style>
    .home-page {
        display: grid;
        grid-template-rows: minmax(0, 0.8fr) auto minmax(0, 1.2fr);
        min-block-size: calc(100dvh - 4.6rem);
    }

    .home-logo {
        align-self: start;
        display: block;
        width: 100%;
        max-width: 24rem;
        height: auto;
        justify-self: center;
        margin-block-start: 1rem;
    }

    .home-actions {
        display: grid;
        gap: 1.5rem;
    }

    .home-button-container {
        max-width: 36rem;
        margin: 0 auto;
        width: 100%;
    }

    .home-nav-button {
        display: block;
        padding: 1.5rem 1.5rem;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 1rem;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.2);
        transition: all 0.3s ease;
        text-decoration: none;
        color: white;
    }

    .home-nav-button:hover,
    .home-nav-button:focus-visible {
        transform: translateY(-0.25rem);
        box-shadow: 0 0.7rem 1.6rem rgba(0, 0, 0, 0.3);
        background: linear-gradient(135deg, #764ba2 0%, #667eea 100%);
        outline: none;
    }

    .home-nav-button h3 {
        margin: 0;
        font-weight: 300;
    }

    .home-image-container {
        align-self: end;
        max-width: 15rem;
        justify-self: center;
    }

    .home-image-boxed {
        display: block;
        width: 100%;
        border-radius: 1rem;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.2);
    }

    .home-image {
        display: block;
        width: 100%;
        height: auto;
    }

    @@media (min-width: 641px) {
        .home-page {
            min-block-size: calc(100dvh - 1.1rem);
        }
    }
</style>


