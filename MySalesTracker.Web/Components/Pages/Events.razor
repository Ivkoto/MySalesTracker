@page "/events"
@attribute [Authorize]

@inject EventService EventSvc

<div class="events-page-header">
    <h2>Събития</h2>
    <div class="events-page-actions">
        <button class="btn btn-primary events-create-button"
                @onclick="OnCreateClicked"
                disabled="@(showCreateForm && !CanSubmit)">
            @(showCreateForm ? "Запази" : "Създай")
        </button>
    </div>
</div>

@if (showCreateForm)
{
    <div class="mb-3 d-flex gap-3 flex-wrap align-items-center">
        <button class="btn btn-outline-secondary" style="height: 2.75rem" @onclick="CancelCreate">Откажи</button>
    </div>
    <div class="mb-3 d-flex gap-3 flex-wrap align-items-center">
        <input @ref="nameInput" @bind="name" class="form-control" style="width: 19rem; height: 2.5rem" placeholder="Име" />
    </div>
    <div class="mb-3 d-flex gap-3 flex-wrap align-items-center">
        <input type="date" class="form-control" style="width: 9rem; height: 2.75rem" @bind="start" />
        <input type="date" class="form-control" style="width: 9rem; height: 2.75rem" @bind="end" />
    </div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
  <div class='alert alert-danger py-2 px-3 mb-3'>
    @errorMessage
  </div>
}

<section class="events-list" aria-label="Списък със събития">
    @foreach (var b in events)
    {
        var isExpanded = expandedEventId == b.EventId;
        var orderedDays = b.Days.OrderBy(x => x.Date).ToList();
        var eventDaysRegionId = $"event-days-{b.EventId}";

        <article class="event-card @(isExpanded ? "event-card-expanded" : "")">
            <div class="event-card-header">
                <h3 class="event-card-title">@b.Name</h3>
                <button type="button"
                        class="event-card-toggle"
                        aria-expanded="@isExpanded"
                        aria-controls="@eventDaysRegionId"
                        aria-label="@($"{(isExpanded ? "Скрий дни за" : "Покажи дни за")} {b.Name}")"
                        @onclick="() => ToggleEventDays(b.EventId)">
                    <span class="event-card-count">@GetDaysLabel(orderedDays.Count)</span>
                    <span class="event-card-toggle-icon bi @(isExpanded ? "bi-chevron-up" : "bi-chevron-down")" aria-hidden="true"></span>
                </button>
            </div>

            <div class="event-card-meta-row">
                <div class="event-card-dates">
                    <span>@b.StartDate</span>
                    <span>@b.EndDate</span>
                </div>
                <div class="event-card-actions">
                    <a href="@($"/event/{b.EventId}/summary")"
                       class="btn btn-outline-success btn-sm">Статистика</a>
                </div>
            </div>

            <div id="@eventDaysRegionId" class="event-days-grid" hidden="@(!isExpanded)">
                @foreach (var d in orderedDays)
                {
                    <a href="@($"/day/{d.EventDayId}")"
                       class="event-day-item @(d.Date == today ? "current-day-highlight" : "")">
                        <strong>@GetFormattedDate(d.Date)</strong>
                    </a>
                }
            </div>
        </article>
    }
</section>

@code {
  string name = $"Базар {DateOnly.FromDateTime(DateTime.Today)}";
  DateOnly start = DateOnly.FromDateTime(DateTime.Today);
  DateOnly end = DateOnly.FromDateTime(DateTime.Today);
  List<Domain.Entities.Event> events = new();
  string? errorMessage;
  DateOnly today = DateOnly.FromDateTime(DateTime.Today);
  ElementReference nameInput;
  bool showCreateForm;
  bool focusName;
  int? expandedEventId;
  bool CanSubmit => showCreateForm && !string.IsNullOrWhiteSpace(name) && start <= end;

  protected override async Task OnInitializedAsync()
      => events = await EventSvc.GetAllEventsAsync();

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (focusName && showCreateForm)
    {
      focusName = false;
      try
      {
        await nameInput.FocusAsync();
      }
      catch
      {
        // Ignore focus failures
      }
    }
  }

  async Task OnCreateClicked()
  {
    if (!showCreateForm)
    {
      PrefillCreateForm();
      showCreateForm = true;
      errorMessage = null;
      focusName = true;
      return;
    }

    await Create();
  }

  void CancelCreate()
  {
    showCreateForm = false;
    errorMessage = null;
    PrefillCreateForm();
    StateHasChanged();
  }

  void PrefillCreateForm()
  {
    var todayDate = DateOnly.FromDateTime(DateTime.Today);
    name = $"Базар {todayDate}";
    start = todayDate;
    end = todayDate;
  }

  async Task Create()
  {      
    var result = await EventSvc.CreateEventAsync(name, start, end);
    if (!result.Success)
    {
      errorMessage = result.ErrorMessage;
      return;
    }

    var savedEvent = result.Data!;
    events.Insert(0, savedEvent);
    expandedEventId = savedEvent.EventId;

        /* TODO: @IvayloK - replace the lines above if you need to reload all the events and keep the data updated on all the devices
        in cases where other users might have created events simultaneously. This come along with creating of a new SignalR notification
        to all the connected to the app clients. Once uncomenting this one, make sure a new method is created in the SignalRNotificationService*/
      //await EventSvc.CreateEventAsync(name, start, end);
      //events = await EventSvc.GetAllEventsAsync(); // Reload all events

      // Reset form
      PrefillCreateForm();
    showCreateForm = false;
    errorMessage = null;
  }

  void ToggleEventDays(int eventId)
  {
    expandedEventId = expandedEventId == eventId ? null : eventId;
  }

  static string GetDaysLabel(int daysCount)
    => daysCount == 1 ? "1 ден" : $"{daysCount} дни";
    

    string GetFormattedDate(DateOnly date)
    {
        var dayOfWeek = date.DayOfWeek;
        var abbreviation = dayOfWeek switch
        {
            DayOfWeek.Monday => "пн",
            DayOfWeek.Tuesday => "вт",
            DayOfWeek.Wednesday => "ср",
            DayOfWeek.Thursday => "чт",
            DayOfWeek.Friday => "пт",
            DayOfWeek.Saturday => "сб",
            DayOfWeek.Sunday => "нд",
            _ => ""
        };
        return $"{date.Day:00} {abbreviation}";
    }
}
